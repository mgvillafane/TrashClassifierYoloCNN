{
  "version": 1,
  "description": "Shared 6-class schema for all datasets. 'classifier': false keeps a box for the detector but drops it from classifier training/evaluation; 'reason' is written to the manifest's exclude_reason.",
  "common_labels": ["cardboard", "glass", "metal", "paper", "plastic", "trash"],
  "shared3_labels": ["cardboard", "metal", "plastic"],
  "classifier_min_crop_side_px": 32,

  "splits": {
    "whole_image_seed": 42,
    "whole_image_ratios": {"train": 0.8, "val": 0.1, "test": 0.1},
    "taco_n_folds": 3,
    "taco_folds_file": "configs/taco_folds.csv"
  },

  "realwaste": {
    "Cardboard":           {"common": "cardboard"},
    "Glass":               {"common": "glass"},
    "Metal":               {"common": "metal"},
    "Paper":               {"common": "paper"},
    "Plastic":             {"common": "plastic"},
    "Miscellaneous Trash": {"common": "trash"},
    "Food Organics":       {"common": "trash", "classifier": false, "reason": "organic; not a material class"},
    "Vegetation":          {"common": "trash", "classifier": false, "reason": "organic; not a material class"},
    "Textile Trash":       {"common": "trash", "classifier": false, "reason": "textile; not a material class"}
  },

  "trashnet": {
    "cardboard": {"common": "cardboard"},
    "glass":     {"common": "glass"},
    "metal":     {"common": "metal"},
    "paper":     {"common": "paper"},
    "plastic":   {"common": "plastic"},
    "trash":     {"common": "trash"}
  },

  "sortwaste": {
    "0": {"name": "pet",                 "common": "plastic"},
    "1": {"name": "pead",                "common": "plastic"},
    "2": {"name": "mixed_plastic_soft",  "common": "plastic"},
    "3": {"name": "ecal",                "common": "cardboard", "classifier": false, "reason": "composite beverage carton; material ambiguous"},
    "4": {"name": "metal",               "common": "metal"},
    "5": {"name": "cardboard",           "common": "cardboard"},
    "6": {"name": "mixed_plastic_rigid", "common": "plastic"},
    "7": {"name": "pet_oleo",            "common": "plastic"}
  },

  "taco": {
    "groups": {
      "cardboard": ["Toilet tube", "Other carton", "Egg carton", "Corrugated carton", "Meal carton", "Pizza box", "Drink carton"],
      "glass": ["Glass bottle", "Broken glass", "Glass cup", "Glass jar"],
      "metal": ["Aluminium foil", "Metal bottle cap", "Food Can", "Aerosol", "Drink can", "Metal lid", "Pop tab", "Scrap metal"],
      "paper": ["Paper cup", "Magazine paper", "Wrapping paper", "Normal paper", "Paper bag", "Paper straw"],
      "plastic": ["Other plastic bottle", "Clear plastic bottle", "Plastic bottle cap", "Disposable plastic cup", "Foam cup", "Other plastic cup", "Plastic lid", "Other plastic", "Plastic film", "Six pack rings", "Garbage bag", "Other plastic wrapper", "Single-use carrier bag", "Polypropylene bag", "Spread tub", "Tupperware", "Disposable food container", "Foam food container", "Other plastic container", "Plastic glooves", "Plastic utensils", "Plastic straw", "Styrofoam piece"],
      "trash": ["Battery", "Aluminium blister pack", "Carded blister pack", "Food waste", "Tissues", "Plastified paper bag", "Crisp packet", "Rope & strings", "Shoe", "Squeezable tube", "Unlabeled litter", "Cigarette"]
    },
    "classifier_exclude": {
      "Unlabeled litter": "material unknown",
      "Food waste":       "organic; not a material class",
      "Shoe":             "textile/mixed; not a material class",
      "Rope & strings":   "textile; not a material class",
      "Drink carton":     "composite beverage carton; consistent with SortWaste ECAL"
    }
  }
}
